{
  "env": {
    "HYPERFRAMES_PYTHON": "/home/dev/Videos/muradworkspace/.tools/venv/bin/python",
    "HYPERFRAMES_CACHE_DIR": "/home/dev/Videos/muradworkspace/.tools/hf-cache",
    "MURAD_CONTEXT_WINDOW": "1000000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Alətlər yoxlanılır..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/context-check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
